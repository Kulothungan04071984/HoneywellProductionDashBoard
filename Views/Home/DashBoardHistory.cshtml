@using ProductionDashboard.Models
@using System.Globalization
@model ProductionDashboard.Models.DashboardHistoryViewModel

@{
    ViewData["Title"] = "Dashboard History";
    var allShifts = new[] { "Morning", "Afternoon", "Night" };

    var shiftData = new Dictionary<string, List<ShiftMetric>>
    {
        ["Morning"] = Model.MorningShift,
        ["Afternoon"] = Model.AfternoonShift,
        ["Night"] = Model.NightShift
    };
    var shiftIcons = new Dictionary<string, string> { ["Morning"] = "fa-sun", ["Afternoon"] = "fa-cloud-sun", ["Night"] = "fa-moon" };
    var shiftLabels = new Dictionary<string, string> { ["Morning"] = "Morning shift", ["Afternoon"] = "Afternoon shift", ["Night"] = "Night shift" };
    var shiftTimes = new Dictionary<string, string> { ["Morning"] = "8:00 AM – 4:00 PM", ["Afternoon"] = "4:00 PM – 12:00 AM", ["Night"] = "12:00 AM – 8:00 AM" };

    var testerSortOrder = new Dictionary<string, int>
    {
        ["FCT1"] = 1, ["RTC"] = 2, ["RTC1"] = 2, ["LCD1"] = 3, ["LCD2"] = 4, ["RF1"] = 5,
        ["FCT2"] = 6, ["VOLT"] = 7, ["VOL1"] = 7, ["RF2"] = 8, ["FCT3"] = 9
    };
    int GetTesterOrder(string tg) => testerSortOrder.TryGetValue(tg, out var o) ? o : 99;

    // The two testers shown in every cumulative view
    var cumulGroups = new[]
    {
        (Label: "Before potting", Name: "VOL1", Css: "g-vol", Pick: (Func<string, bool>)(tg => tg.StartsWith("VOL"))),
        (Label: "After potting",  Name: "FCT3", Css: "g-fct", Pick: (Func<string, bool>)(tg => tg == "FCT3"))
    };

    DateTime DateKey(string s) =>
        DateTime.TryParseExact(s, "dd-MM-yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : DateTime.MinValue;

    (decimal T, decimal A, int N) SumOf(IEnumerable<ShiftMetric> rows, Func<string, bool> pick)
    {
        var r = rows.Where(m => m.TesterGroup != "TOTAL" && pick(m.TesterGroup)).ToList();
        return (r.Sum(x => x.Target), r.Sum(x => x.Actual), r.Count);
    }
    double Pct(decimal t, decimal a) => t > 0 ? Math.Round((double)a / (double)t * 100, 0) : 0;
    string Cls(decimal t, decimal a) { var p = t > 0 ? (double)a / (double)t * 100 : 0; return p >= 95 ? "ok" : p >= 80 ? "warn" : "bad"; }
    string PctColor(double p) => p >= 95 ? "var(--ok)" : p >= 80 ? "var(--warn)" : "var(--bad)";

    // Cumulative panels: id, title, subtitle, accent class, rows
    var allRows = allShifts.SelectMany(s => shiftData[s]).ToList();
    var cumulPanels = new List<(string Id, string Title, string Sub, string Css, List<ShiftMetric> Rows)>
    {
        ("panel-day", "Day-wise cumulative", "All three shifts added together", "s-day", allRows)
    };
    foreach (var s in allShifts)
    {
        cumulPanels.Add(("panel-cumul-" + s, shiftLabels[s] + " cumulative", shiftTimes[s], "s-" + s.ToLower(), shiftData[s]));
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard History</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #f3f6fa; --surface: #ffffff; --ink: #16243a; --muted: #5b6b82; --line: #d8e0ea; --head: #eaf0f7;
            --blue: #1769c2;
            --ok: #11743f; --ok-bg: #e3f6ec; --warn: #8a5a00; --warn-bg: #fff4d6; --bad: #b4233f; --bad-bg: #fde8ec;
            --vol: #1a5fb4; --vol-bg: #e8f1fc; --vol-cell: #f4f8fe;
            --fct: #6b3fb0; --fct-bg: #f0eafa; --fct-cell: #f8f5fd;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; }
        body { background: var(--bg); color: var(--ink); font-family: 'IBM Plex Sans', sans-serif; min-height: 100vh; }
        .num, td, .info-chip span { font-variant-numeric: tabular-nums; }

        .s-day       { --accent: #1769c2; --tint: #e8f1fc; }
        .s-morning   { --accent: #b45f00; --tint: #fff1dc; }
        .s-afternoon { --accent: #0a7f6f; --tint: #e0f5f1; }
        .s-night     { --accent: #4a5a8a; --tint: #e8ecf6; }

        .app-header { background: var(--surface); border-bottom: 1px solid var(--line); padding: .9rem 2rem; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
        .brand { display: flex; align-items: center; gap: 1rem; }
        .brand-icon { width: 40px; height: 40px; background: var(--blue); color: #fff; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
        .brand-title { font-size: 1.35rem; font-weight: 700; }
        .brand-sub { font-size: .85rem; color: var(--muted); }
        .header-logo { height: 38px; }
        .back-btn { border: 1px solid var(--line); color: var(--blue); background: var(--surface); border-radius: 8px; padding: .45rem 1rem; font-size: .9rem; font-weight: 600; text-decoration: none; display: flex; gap: .5rem; align-items: center; }
        .back-btn:hover { background: var(--head); color: var(--blue); }

        .info-bar { padding: .7rem 2rem; background: var(--surface); border-bottom: 1px solid var(--line); display: flex; gap: 2rem; flex-wrap: wrap; align-items: center; }
        .info-chip { font-size: .85rem; color: var(--muted); display: flex; gap: .45rem; align-items: center; }
        .info-chip span { color: var(--ink); font-weight: 600; }

        .shift-tabs { display: flex; flex-wrap: wrap; background: var(--surface); border-bottom: 1px solid var(--line); padding: 0 2rem; }
        .tab-divider { width: 1px; background: var(--line); margin: .5rem .7rem; }
        .shift-tab { display: flex; align-items: center; gap: .5rem; padding: .8rem 1.1rem; font-size: .92rem; font-weight: 600; color: var(--muted); border: 0; background: transparent; border-bottom: 3px solid transparent; cursor: pointer; white-space: nowrap; }
        .shift-tab:hover { color: var(--ink); }
        .shift-tab.active { color: var(--accent); border-bottom-color: var(--accent); background: var(--tint); }
        .tab-badge { font-size: .72rem; padding: .1rem .45rem; border-radius: 4px; background: var(--tint); color: var(--accent); font-family: 'IBM Plex Mono', monospace; }
        .cumul-badge { font-size: .65rem; padding: .08rem .35rem; border-radius: 4px; border: 1px dashed var(--accent); color: var(--accent); }

        .main-content { padding: 1.5rem 2rem; }
        .shift-panel { display: none; border-radius: 10px; overflow: hidden; border: 1px solid var(--line); background: var(--surface); box-shadow: 0 2px 10px rgba(22,36,58,.06); }
        .shift-panel.visible { display: block; }
        .shift-header { padding: .9rem 1.5rem; display: flex; align-items: center; justify-content: space-between; background: var(--tint); border-bottom: 3px solid var(--accent); }
        .shift-title-group { display: flex; align-items: center; gap: 1rem; color: var(--accent); }
        .shift-name { font-size: 1.2rem; font-weight: 700; }
        .shift-time { font-size: .85rem; color: var(--muted); }
        .shift-summary { display: flex; gap: 2rem; }
        .sum-item { display: flex; flex-direction: column; align-items: flex-end; font-size: .72rem; color: var(--muted); }
        .sum-val { font-family: 'IBM Plex Mono', monospace; font-size: 1.15rem; color: var(--ink); }

        .table-wrap { overflow-x: auto; }
        table.prod-table { width: 100%; border-collapse: collapse; text-align: center; min-width: 900px; }
        .prod-table th, .prod-table td { border: 1px solid var(--line); padding: 9px 10px; }
        .corner-head { background: var(--head); color: var(--muted); font-weight: 600; width: 110px; }
        .group-head { background: var(--head); color: var(--ink); font-size: 1.05rem; font-weight: 700; }
        .sub-head { background: #f5f8fc; color: var(--muted); font-size: .8rem; font-weight: 600; }
        .date-col { background: var(--head); color: var(--muted); font-family: 'IBM Plex Mono', monospace; font-size: .85rem; white-space: nowrap; }
        .hour-cell { background: #f5f8fc; font-weight: 600; }
        .target-cell { color: var(--blue); font-weight: 600; }
        td.ok { background: var(--ok-bg); color: var(--ok); font-weight: 600; }
        td.warn { background: var(--warn-bg); color: var(--warn); font-weight: 600; }
        td.bad { background: var(--bad-bg); color: var(--bad); font-weight: 600; }
        .total-row td { font-weight: 700; border-top: 2px solid var(--ink); }

        /* VOL1 and FCT3 shading in the cumulative tables */
        th.g-vol { background: var(--vol-bg); color: var(--vol); border-bottom: 2px solid var(--vol); }
        th.g-fct { background: var(--fct-bg); color: var(--fct); border-bottom: 2px solid var(--fct); }
        th.g-vol small, th.g-fct small { display: block; font-size: .72rem; font-weight: 600; opacity: .85; }
        td.g-vol.target-cell { background: var(--vol-cell); color: var(--vol); }
        td.g-fct.target-cell { background: var(--fct-cell); color: var(--fct); }
        .g-first { border-left: 3px solid var(--line) !important; }

        .empty-state { padding: 3rem; text-align: center; color: var(--muted); }
        .empty-state i { font-size: 2rem; display: block; margin-bottom: .8rem; opacity: .5; }
        .app-footer { padding: 1rem 2rem; border-top: 1px solid var(--line); background: var(--surface); display: flex; justify-content: space-between; font-size: .8rem; color: var(--muted); }
    </style>
</head>
<body>

    <header class="app-header">
        <div class="brand">
            <div class="brand-icon"><i class="fas fa-history"></i></div>
            <div>
                <div class="brand-title">Production history</div>
                <div class="brand-sub">Date range report</div>
            </div>
            <img src="@Url.Content("~/Images/syrma-logo.png")" class="header-logo" alt="Logo" />
        </div>
        <a href="/Home/Dashboard" class="back-btn"><i class="fas fa-arrow-left"></i> Back to live dashboard</a>
    </header>

    <div class="info-bar">
        <div class="info-chip"><i class="fas fa-box"></i> Product: <span>@Model.Product</span></div>
        <div class="info-chip"><i class="fas fa-calendar-day"></i> From: <span>@Model.FromDate</span></div>
        <div class="info-chip"><i class="fas fa-calendar-check"></i> To: <span>@Model.ToDate</span></div>
        <div class="info-chip ms-auto"><i class="fas fa-database"></i> Total records: <span>@(Model.MorningShift.Count + Model.AfternoonShift.Count + Model.NightShift.Count)</span></div>
    </div>

    <div class="shift-tabs">
        @foreach (var shift in allShifts)
        {
            var (tT, tA, _) = SumOf(shiftData[shift], tg => true);
            <button class="shift-tab s-@shift.ToLower()" data-panel="panel-@shift" onclick="switchTab(this)">
                <i class="fas @shiftIcons[shift]"></i> @shift
                <span class="tab-badge">@Pct(tT, tA)%</span>
            </button>
        }

        <div class="tab-divider"></div>

        @foreach (var p in cumulPanels)
        {
            var (tT, tA, _) = SumOf(p.Rows, tg => cumulGroups.Any(g => g.Pick(tg)));
            <button class="shift-tab @p.Css" data-panel="@p.Id" onclick="switchTab(this)">
                @if (p.Id == "panel-day")
                {
                    <i class="fas fa-calendar-days"></i> <span>Day-wise cumulative</span>
                }
                else
                {
                    var sn = p.Id.Replace("panel-cumul-", "");
                    <i class="fas @shiftIcons[sn]"></i> <span>@sn</span> <span class="cumul-badge">CUMUL</span>
                }
                <span class="tab-badge">@Pct(tT, tA)%</span>
            </button>
        }
    </div>

    <main class="main-content">

        @* ═══ Hourly panels: every hour shows a target for every tester ═══ *@
        @foreach (var shift in allShifts)
        {
            var rows = shiftData[shift].Where(m => m.TesterGroup != "TOTAL").ToList();
            var testers = rows.Select(x => x.TesterGroup).Distinct().OrderBy(tg => GetTesterOrder(tg)).ToList();
            var byDate = rows.GroupBy(x => x.DateValue).OrderBy(g => DateKey(g.Key)).ToList();
            var (tT, tA, _) = SumOf(rows, tg => true);
            var tPct = Pct(tT, tA);

            <div class="shift-panel s-@shift.ToLower()" id="panel-@shift">
                <div class="shift-header">
                    <div class="shift-title-group">
                        <i class="fas @shiftIcons[shift]" style="font-size:1.3rem"></i>
                        <div>
                            <div class="shift-name">@shiftLabels[shift]</div>
                            <div class="shift-time">@shiftTimes[shift]</div>
                        </div>
                    </div>
                    <div class="shift-summary">
                        <div class="sum-item"><span class="sum-val" style="color:@PctColor(tPct)">@tPct%</span>Overall</div>
                     @*    <div class="sum-item"><span class="sum-val">@tT.ToString("0")</span>Target</div>
                        <div class="sum-item"><span class="sum-val" style="color:@PctColor(tPct)">@tA.ToString("0")</span>Actual</div> *@
                    </div>
                </div>
                <div class="table-wrap">
                    @if (!rows.Any())
                    {
                        <div class="empty-state"><i class="fas fa-inbox"></i>No data for this shift in the selected date range</div>
                    }
                    else
                    {
                        <table class="prod-table">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="corner-head">Date</th>
                                    <th rowspan="2" class="corner-head">Hour</th>
                                    @foreach (var tg in testers) { <th colspan="2" class="group-head">@tg</th> }
                                </tr>
                                <tr>
                                    @foreach (var tg in testers)
                                    {
                                        <th class="sub-head">T</th>
                                        <th class="sub-head">A</th>
                                      @*   <th class="sub-head">Gap</th>
                                        <th class="sub-head">Loss %</th> *@
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var day in byDate)
                                {
                                    var hours = day.Select(x => x.HourRange).Distinct().OrderBy(h => h).ToList();
                                    for (int hi = 0; hi < hours.Count; hi++)
                                    {
                                        <tr>
                                            @if (hi == 0) { <td class="date-col" rowspan="@hours.Count">@day.Key</td> }
                                            <td class="hour-cell">@hours[hi]</td>
                                            @foreach (var tg in testers)
                                            {
                                                var row = day.FirstOrDefault(x => x.HourRange == hours[hi] && x.TesterGroup == tg);
                                                decimal tgt = row?.Target ?? 0, act = row?.Actual ?? 0, gap = tgt - act;
                                                decimal loss = tgt > 0 ? Math.Round(gap / tgt * 100, 2) : 0;
                                                var cls = Cls(tgt, act);
                                                <td class="target-cell">@(row == null ? "-" : tgt.ToString("0"))</td>
                                                <td class="@cls">@(row == null ? "-" : act.ToString("0"))</td>
                                               @*  <td class="@cls">@(row == null ? "-" : gap.ToString("0"))</td>
                                                <td class="@cls">@(row == null ? "-" : loss.ToString("0.##") + "%")</td> *@
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }

        @* ═══ Cumulative panels: day-wise (3 shifts added) + one per shift. VOL1 and FCT3 only, never added together ═══ *@
        @foreach (var p in cumulPanels)
        {
            var dates = p.Rows.Where(m => m.TesterGroup != "TOTAL").Select(m => m.DateValue).Distinct().OrderBy(d => DateKey(d)).ToList();
            var (tT, tA, _) = SumOf(p.Rows, tg => cumulGroups.Any(g => g.Pick(tg)));
            var tPct = Pct(tT, tA);

            <div class="shift-panel @p.Css" id="@p.Id">
                <div class="shift-header">
                    <div class="shift-title-group">
                        <i class="fas @(p.Id == "panel-day" ? "fa-calendar-days" : shiftIcons[p.Id.Replace("panel-cumul-", "")])" style="font-size:1.3rem"></i>
                        <div>
                            <div class="shift-name">@p.Title</div>
                            <div class="shift-time">@p.Sub</div>
                        </div>
                    </div>
                    <div class="shift-summary">
                        <div class="sum-item"><span class="sum-val" style="color:@PctColor(tPct)">@tPct%</span>Overall</div>
                    </div>
                </div>
                <div class="table-wrap">
                    @if (!dates.Any())
                    {
                        <div class="empty-state"><i class="fas fa-inbox"></i>No data in the selected date range</div>
                    }
                    else
                    {
                        <table class="prod-table">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="corner-head">Date</th>
                                    @foreach (var g in cumulGroups) { <th colspan="2" class="group-head @g.Css g-first">@g.Name<small>@g.Label</small></th> }
                                </tr>
                                <tr>
                                    @foreach (var g in cumulGroups)
                                    {
                                        <th class="sub-head g-first">T</th>
                                        <th class="sub-head">A</th>
                                       @*  <th class="sub-head">Gap</th>
                                        <th class="sub-head">Loss %</th> *@
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in dates)
                                {
                                    var dayRows = p.Rows.Where(m => m.DateValue == d).ToList();
                                    <tr>
                                        <td class="date-col">@d</td>
                                        @foreach (var g in cumulGroups)
                                        {
                                            var (t, a, n) = SumOf(dayRows, g.Pick);
                                            var gap = t - a;
                                            var loss = t > 0 ? Math.Round(gap / t * 100, 2) : 0;
                                            var cls = Cls(t, a);
                                            <td class="target-cell @g.Css g-first">@(n == 0 ? "-" : t.ToString("0"))</td>
                                            <td class="@cls">@(n == 0 ? "-" : a.ToString("0"))</td>
                                           @*  <td class="@cls">@(n == 0 ? "-" : gap.ToString("0"))</td>
                                            <td class="@cls">@(n == 0 ? "-" : loss.ToString("0.##") + "%")</td> *@
                                        }
                                    </tr>
                                }
                                @if (dates.Count > 1)
                                {
                                    <tr class="total-row">
                                        <td class="date-col">Range total</td>
                                        @foreach (var g in cumulGroups)
                                        {
                                            var (t, a, _) = SumOf(p.Rows, g.Pick);
                                            var gap = t - a;
                                            var loss = t > 0 ? Math.Round(gap / t * 100, 2) : 0;
                                            var cls = Cls(t, a);
                                            <td class="target-cell @g.Css g-first">@t.ToString("0")</td>
                                            <td class="@cls">@a.ToString("0")</td>
                                            <td class="@cls">@gap.ToString("0")</td>
                                            <td class="@cls">@loss.ToString("0.##")%</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    </main>

    <footer class="app-footer">
        <span>SyrmaSGS Honeywell — history report</span>
        <span>@Model.FromDate to @Model.ToDate</span>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        function switchTab(btn) {
            document.querySelectorAll('.shift-panel').forEach(function (p) {
                p.classList.toggle('visible', p.id === btn.dataset.panel);
            });
            document.querySelectorAll('.shift-tab').forEach(function (t) {
                t.classList.toggle('active', t === btn);
            });
        }
        document.addEventListener('DOMContentLoaded', function () {
            var first = document.querySelector('[data-panel="panel-Morning"]');
            if (first) switchTab(first);
        });
    </script>
</body>
</html>
